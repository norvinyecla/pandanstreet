PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
SESSION_SECRET=change-me-in-production
# Local Supabase: start it with `yarn db:start`, then copy the API URL and
# service_role / secret key from `yarn db:status`. Server-side only: never
# expose the service-role key to the frontend.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Photo storage (AWS S3). Photos are uploaded under photos/ in this bucket and
# loaded by the browser from PHOTOS_BASE_URL/photos/<file>, so the bucket must
# allow public reads of photos/* (see README). AWS credentials are NOT set
# here: the AWS SDK reads them from its default chain (e.g. AWS_PROFILE or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in your shell, an IAM role on EC2).
AWS_REGION=ap-southeast-2
S3_BUCKET=
PHOTOS_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com
